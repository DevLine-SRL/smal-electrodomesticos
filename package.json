{
  "name": "smal-electrodomesticos",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write ./src",
    "format:check": "prettier --check ./src",
    "supabase:setup": "supabase login && supabase link && supabase db push --linked && supabase functions deploy --use-api",
    "supabase:deploy": "supabase db push --linked && supabase functions deploy --use-api",
    "supabase:status": "supabase migration list --linked && supabase functions list",
    "supabase:local:start": "supabase start",
    "supabase:local:stop": "supabase stop",
    "supabase:local:reset": "supabase db reset",
    "supabase:local:types": "supabase gen types typescript --local > src/db/database.types.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.4",
    "@astrojs/react": "^6.0.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.2.4",
    "astro-icons": "^0.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@iconify-json/lucide": "^1.2.124",
    "@iconify-json/simple-icons": "^1.2.93",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.115.0",
    "typescript": "^6"
  }
}

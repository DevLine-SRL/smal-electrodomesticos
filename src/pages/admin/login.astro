---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import Logo from '../../components/ui/Logo.astro';
import LoginForm from '../../components/admin/LoginForm';
import { sanitizeNextPath } from '../../services/auth/session';
import LockIcon from 'virtual:icons/lucide/lock?astro';

// Quien ya tiene sesion valida no deberia ver el formulario.
if (Astro.locals.profile) {
  return Astro.redirect(sanitizeNextPath(Astro.url.searchParams.get('next')));
}

const next = sanitizeNextPath(Astro.url.searchParams.get('next'));
---

<Base title="Iniciar sesión | SMAL Admin">
  <div
    class="bg-background flex min-h-screen flex-col items-center justify-center px-5 py-12"
  >
    <div class="w-full max-w-sm">
      <div class="mb-8 flex justify-center">
        <Logo />
      </div>

      <div
        class="border-border-subtle bg-card shadow-inner-dark rounded-3xl border p-8"
      >
        <div
          class="bg-primary-400/15 text-primary-400 mx-auto grid h-12 w-12 place-items-center rounded-2xl"
        >
          <LockIcon class="h-6 w-6" />
        </div>

        <h1
          class="font-display text-text-primary mt-5 text-center text-2xl font-extrabold tracking-tight"
        >
          Acceso de administrador
        </h1>
        <p class="text-text-muted mt-1.5 text-center text-sm">
          Ingresa tus credenciales para continuar.
        </p>

        <LoginForm client:load next={next} />
      </div>

      <p class="text-text-muted mt-6 text-center text-sm">
        <a
          href="/"
          class="text-text-secondary hover:text-primary-400 transition-colors"
        >
          ← Volver a la tienda
        </a>
      </p>
    </div>
  </div>
</Base>

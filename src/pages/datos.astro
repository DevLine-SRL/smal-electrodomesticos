---
// Esta página consulta Supabase y debe renderizarse con la configuración del
// entorno en ejecución, no durante el build.
export const prerender = false;

import { supabase } from '../db/supabase';

const { data, error } = await supabase
  .from('products')
  .select('id, name, price, status');
---

{error && <p class="text-red-600">{error.message}</p>}

{
  (
    <ul>
      {data?.map((entry) => (
        <li>
          {entry.name} — ${entry.price} ({entry.status})
        </li>
      ))}
    </ul>
  )
}

---
export const prerender = false;

import PublicLayout from '../../layouts/PublicLayout.astro';
import ProductFilters from '../../components/products/ProductFilters.astro';
import ProductGrid from '../../components/products/ProductGrid.astro';
import ProductsSummary from '../../components/products/ProductsSummary.astro';
import Pagination from '../../components/products/Pagination.astro';
import { getProductCatalog } from '../../services/products/catalog';

const {
  categories,
  products,
  selectedCategorySlug,
  searchTerm,
  page,
  totalPages,
  totalProducts,
  paginationPages,
  buildPageHref,
} = await getProductCatalog(new URL(Astro.request.url));
---

<PublicLayout
  title="Catálogo completo"
  description="Todos nuestros electrodomésticos disponibles. Precios de contado y asesoría por WhatsApp. Entre Ríos, Cochabamba."
>
  <section class="bg-background-soft border-border-subtle border-b py-9">
    <div class="mx-auto w-full max-w-7xl px-5 sm:px-8">
      <p class="kicker text-primary-400 font-bold">Catálogo</p>
      <h1
        class="font-display reveal mt-3 text-4xl font-extrabold tracking-tight text-white sm:text-6xl"
      >
        Todos nuestros productos
      </h1>
      <p class="reveal text-text-secondary mt-4 max-w-2xl leading-relaxed">
        Explora productos disponibles por categoría y nombre. Todos los precios
        son de contado y la atención es por WhatsApp.
      </p>
    </div>
  </section>

  <section class="mx-auto w-full max-w-7xl px-5 py-16 sm:px-8">
    <ProductFilters
      categories={categories}
      searchTerm={searchTerm}
      selectedCategorySlug={selectedCategorySlug}
    />
    <ProductsSummary
      shownCount={products.length}
      totalProducts={totalProducts}
      page={page}
      totalPages={totalPages}
    />
    <ProductGrid products={products} />
    <Pagination
      page={page}
      totalPages={totalPages}
      paginationPages={paginationPages}
      buildPageHref={buildPageHref}
    />
  </section>
</PublicLayout>

---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { PRODUCTS, buildWhatsAppLink } from '../../data/products';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { id: String(product.id) },
    props: { product },
  }));
}

interface Props {
  product: (typeof PRODUCTS)[number];
}

const { product } = Astro.props;
---

<PublicLayout title={`${product.name} | Tu Electrodoméstico`}>
  <a href="/" class="mb-6 inline-block text-sm font-medium text-gray-500 transition hover:text-gray-900">
    ← Volver al inicio
  </a>

  <article class="flex flex-col gap-8 rounded-2xl border border-gray-200 bg-white p-8 shadow-sm md:flex-row">
    <div class="flex items-center justify-center rounded-xl bg-gray-50 p-16 text-8xl">
      {product.emoji}
    </div>

    <div class="flex flex-1 flex-col">
      <h1 class="text-3xl font-bold text-gray-900">{product.name}</h1>
      <p class="mt-2 text-sm text-gray-500">SKU: {product.sku}</p>
      <p class="mt-4 text-gray-700">{product.description}</p>
      <p class="mt-6 text-3xl font-bold text-green-600">
        ${product.price.toLocaleString('es-MX')}
      </p>

      <a
        href={buildWhatsAppLink(product)}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex w-fit items-center justify-center gap-2 rounded-full bg-green-500 px-6 py-3 font-semibold text-white transition hover:bg-green-600"
      >
        Cotizar por WhatsApp
      </a>
    </div>
  </article>
</PublicLayout>
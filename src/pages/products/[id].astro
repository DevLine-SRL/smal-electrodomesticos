export const prerender = false;

import PublicLayout from '../../layouts/PublicLayout.astro';
import ProductContact from '../../components/products/ProductContact.tsx';
import { getProductDetail } from '../../services/products/detail';

const product = await getProductDetail(Astro.locals.supabase, Astro.params.id ?? '');

if (!product) return Astro.redirect('/404');

const contactProduct = {
  id: product.id,
  name: product.name,
  price: product.price,
  sku: product.slug,
  emoji: '',
  description: product.description ?? '',
  available: product.status === 'available' && product.quantity > 0,
};

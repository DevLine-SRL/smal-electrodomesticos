export const prerender = false;

import { getProductDetail } from '../../services/products/publicDetail';

// Preserve previously shared links using the canonical slug from the database.
const identifier = Astro.params.id ?? '';
const isUuid =
  /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(
    identifier,
  );
if (isUuid) {
  try {
    const product = await getProductDetail(identifier, true);
    if (product)
      return Astro.redirect(
        `/producto/${encodeURIComponent(product.slug)}`,
        301,
      );
  } catch {
    // The detail route renders a friendly 503 if the backend remains unavailable.
  }
  return Astro.rewrite(`/producto/${encodeURIComponent(identifier)}`);
}
return Astro.redirect(`/producto/${encodeURIComponent(identifier)}`, 301);

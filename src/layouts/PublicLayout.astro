---
import Base from './Base.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description?: string;
  full?: boolean;
}

const { title, description, full = false } = Astro.props;
---

<Base title={title} description={description}>
  <div class="flex min-h-screen flex-col">
    <Navbar />

    <main
      class={`flex-1 ${full ? 'w-full' : 'mx-auto w-full max-w-7xl px-5 py-8 sm:px-8 sm:py-12'}`}
    >
      <slot />
    </main>

    <Footer />
  </div>
</Base>

---
import type { Category, ProductDetail } from '../../../types/products';

interface Props {
  product: ProductDetail;
  categories: Category[];
}

const { product, categories } = Astro.props;
const MAX_IMAGES = 4;
---

<form
  id="edit-product-form"
  enctype="multipart/form-data"
  novalidate
  class="mx-auto max-w-4xl space-y-6"
>
  <input type="hidden" name="productId" value={product.id} />

  <section
    class="border-border-subtle bg-background-soft rounded-2xl border p-5 sm:p-7"
  >
    <div class="mb-6">
      <p class="text-primary-400 text-xs font-bold tracking-[0.16em] uppercase">
        Catálogo
      </p>
      <h2 class="font-display text-text-primary mt-1 text-2xl font-extrabold">
        Información del producto
      </h2>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <label class="block sm:col-span-2">
        <span class="text-text-primary mb-2 block text-sm font-bold"
          >Nombre <span class="text-error-500">*</span></span
        >
        <input
          name="name"
          required
          maxlength="160"
          autocomplete="off"
          class="field"
          placeholder="Ej. Licuadora Oster 2 velocidades"
          value={product.name}
        />
        <span data-error="name" class="field-error"></span>
      </label>
      <label class="block sm:col-span-2">
        <span class="text-text-primary mb-2 block text-sm font-bold"
          >Descripción</span
        >
        <textarea
          name="description"
          rows="4"
          maxlength="2000"
          class="field resize-y"
          placeholder="Características, estado y detalles relevantes"
          >{product.description ?? ''}</textarea
        >
        <span data-error="description" class="field-error"></span>
      </label>
      <label class="block">
        <span class="text-text-primary mb-2 block text-sm font-bold"
          >Precio <span class="text-error-500">*</span></span
        >
        <input
          name="price"
          type="number"
          required
          min="0.01"
          step="0.01"
          inputmode="decimal"
          class="field"
          placeholder="0.00"
          value={product.price}
        />
        <span data-error="price" class="field-error"></span>
      </label>
      <label class="block">
        <span class="text-text-primary mb-2 block text-sm font-bold"
          >Cantidad <span class="text-error-500">*</span></span
        >
        <input
          name="quantity"
          type="number"
          required
          min="0"
          step="1"
          inputmode="numeric"
          class="field"
          placeholder="0"
          value={product.quantity}
        />
        <span data-error="quantity" class="field-error"></span>
      </label>
      <label class="block sm:col-span-2">
        <span class="text-text-primary mb-2 block text-sm font-bold"
          >Categoría <span class="text-error-500">*</span></span
        >
        <select name="categoryId" required class="field cursor-pointer">
          <option value="">Selecciona una categoría</option>
          {
            categories.map((category) => (
              <option
                value={category.id}
                selected={category.id === product.categoryId}
              >
                {category.name}
              </option>
            ))
          }
        </select>
        <span data-error="categoryId" class="field-error"></span>
      </label>
    </div>
  </section>

  <section
    class="border-border-subtle bg-background-soft rounded-2xl border p-5 sm:p-7"
  >
    <div
      class="mb-5 flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between"
    >
      <div>
        <p
          class="text-primary-400 text-xs font-bold tracking-[0.16em] uppercase"
        >
          Galería
        </p>
        <h2 class="font-display text-text-primary mt-1 text-2xl font-extrabold">
          Fotografías
        </h2>
      </div>
      <p class="text-text-muted text-xs" id="image-count-label">
        {product.images.length} de {MAX_IMAGES} imágenes · JPG, PNG, WEBP o GIF ·
        máx. 5 MB
      </p>
    </div>

    {/* Imágenes existentes */}
    <div
      id="existing-images"
      class="mb-5 grid grid-cols-2 gap-3 sm:grid-cols-4"
    >
      {
        product.images.map((image) => (
          <figure
            class="bg-background border-border-subtle group relative overflow-hidden rounded-xl border transition-all"
            data-image-id={image.id}
            data-image-exists="true"
          >
            <img
              src={image.url}
              alt={`Imagen ${image.position + 1}`}
              class="h-28 w-full object-cover"
            />
            <button
              type="button"
              class="delete-image bg-error-500/80 hover:bg-error-500 absolute top-1.5 right-1.5 z-10 cursor-pointer rounded-full p-1 text-white opacity-0 transition-opacity group-hover:opacity-100"
              aria-label="Eliminar imagen"
              data-image-id={image.id}
            >
              <svg
                class="h-3.5 w-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M6 18L18 6M6 6l12 12"
                />
              </svg>
            </button>
            <figcaption class="text-text-muted truncate px-2 py-1.5 text-xs">
              Imagen {image.position + 1}
            </figcaption>
          </figure>
        ))
      }
    </div>

    {/* Upload de nuevas imágenes */}
    <label
      id="upload-label"
      class="border-border-strong bg-background hover:border-primary-400/70 focus-within:border-primary-400 focus-within:ring-primary-400/25 group flex min-h-40 cursor-pointer flex-col items-center justify-center rounded-xl border border-dashed px-4 py-5 text-center transition-colors focus-within:ring-4 sm:min-h-44 sm:px-8 sm:py-6"
    >
      <input
        id="product-photos"
        name="photos"
        type="file"
        accept="image/jpeg,image/png,image/webp,image/gif"
        multiple
        aria-describedby="photo-upload-help"
        class="sr-only"
      />
      <span
        class="bg-primary-400/12 text-primary-400 group-hover:bg-primary-400/18 mb-3 flex h-11 w-11 items-center justify-center rounded-full transition-colors sm:mb-4 sm:h-12 sm:w-12"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          class="h-5 w-5 sm:h-6 sm:w-6"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M5 14v3.25A1.75 1.75 0 006.75 19h10.5A1.75 1.75 0 0019 17.25V14"
          ></path>
        </svg>
      </span>
      <span class="text-text-primary text-sm font-bold sm:text-base"
        >Agregar más fotografías</span
      >
      <span
        id="photo-upload-help"
        class="text-text-muted mt-1 max-w-sm text-xs leading-5 sm:text-sm"
        >Toca aquí para elegir una o varias imágenes.</span
      >
      <span class="text-primary-400 mt-3 text-xs font-bold sm:hidden"
        >JPG, PNG, WEBP o GIF · máx. 5 MB</span
      >
    </label>
    <span data-error="photos" class="field-error"></span>
    <div id="photo-previews" class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
    </div>
  </section>

  <div
    id="form-message"
    role="alert"
    aria-live="polite"
    class="hidden rounded-xl border px-4 py-3 text-sm font-semibold"
  >
  </div>
  <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
    <a
      href="/admin/products"
      class="border-border-strong text-text-secondary hover:text-text-primary rounded-xl border px-5 py-2.5 text-center text-sm font-bold transition-colors"
    >
      Cancelar
    </a>
    <button
      id="save-product"
      type="submit"
      class="bg-primary-400 text-primary-950 hover:bg-primary-300 cursor-pointer rounded-xl px-5 py-2.5 text-sm font-extrabold transition-colors disabled:cursor-wait disabled:opacity-70"
    >
      Guardar cambios
    </button>
  </div>
</form>

<script define:vars={{ MAX_IMAGES }}>
  const form = document.querySelector('#edit-product-form');
  const photoInput = document.querySelector('#product-photos');
  const previews = document.querySelector('#photo-previews');
  const message = document.querySelector('#form-message');
  const submitButton = document.querySelector('#save-product');
  const imageCountLabel = document.querySelector('#image-count-label');
  const uploadLabel = document.querySelector('#upload-label');
  const maxFileSize = 5 * 1024 * 1024;
  const imageTypes = new Set([
    'image/jpeg',
    'image/png',
    'image/webp',
    'image/gif',
  ]);

  // Contar imágenes iniciales
  let existingCount = document.querySelectorAll('[data-image-exists]').length;
  const deletedImageIds = new Set();
  let hasUnsavedChanges = false;

  const updateImageCountLabel = () => {
    if (!imageCountLabel) return;
    const remaining = existingCount - deletedImageIds.size;
    imageCountLabel.textContent = `${remaining} de ${MAX_IMAGES} imágenes · JPG, PNG, WEBP o GIF · máx. 5 MB`;
  };

  const updateUploadDisabled = () => {
    if (!uploadLabel || !photoInput) return;
    const remaining = existingCount - deletedImageIds.size;
    const available = MAX_IMAGES - remaining;
    if (available <= 0) {
      uploadLabel.classList.add('opacity-40', 'pointer-events-none');
      photoInput.disabled = true;
    } else {
      uploadLabel.classList.remove('opacity-40', 'pointer-events-none');
      photoInput.disabled = false;
    }
  };

  const setError = (name, value = '') => {
    const element = document.querySelector(`[data-error="${name}"]`);
    if (element) element.textContent = value;
  };

  const showMessage = (text, tone) => {
    if (!message) return;
    message.textContent = text;
    message.className = `rounded-xl border px-4 py-3 text-sm font-semibold ${tone === 'error' ? 'border-error-500/40 bg-error-500/12 text-error-500' : 'border-success-500/40 bg-success-500/12 text-success-500'}`;
  };

  const validateFiles = (files) => {
    if (files.some((file) => !imageTypes.has(file.type)))
      return 'Solo se aceptan imágenes JPG, PNG, WEBP o GIF.';
    if (files.some((file) => file.size > maxFileSize))
      return 'Cada imagen debe pesar como máximo 5 MB.';
    const remaining = existingCount - deletedImageIds.size;
    const available = MAX_IMAGES - remaining;
    if (files.length > available)
      return `Solo puedes agregar ${available} imagen${available === 1 ? '' : 'es'} más (máximo ${MAX_IMAGES} en total).`;
    return '';
  };

  const renderPreviews = (files) => {
    if (!previews) return;
    previews.replaceChildren();
    for (const file of files) {
      const card = document.createElement('figure');
      card.className =
        'bg-background overflow-hidden rounded-xl border border-border-subtle';
      const image = document.createElement('img');
      image.src = URL.createObjectURL(file);
      image.alt = `Vista previa: ${file.name}`;
      image.className = 'h-28 w-full object-cover';
      image.onload = () => URL.revokeObjectURL(image.src);
      const caption = document.createElement('figcaption');
      caption.className = 'text-text-muted truncate px-2 py-1.5 text-xs';
      caption.textContent = file.name;
      card.append(image, caption);
      previews.append(card);
    }
  };

  // Eliminar imágenes existentes
  document.querySelectorAll('.delete-image').forEach((btn) => {
    btn.addEventListener('click', () => {
      const imageId = btn.dataset.imageId;
      if (!imageId) return;

      const figure = btn.closest('figure');
      if (!figure) return;

      if (deletedImageIds.has(imageId)) {
        // Deseleccionar: restaurar imagen
        deletedImageIds.delete(imageId);
        figure.style.opacity = '';
        figure.style.pointerEvents = '';
        figure.style.textDecoration = '';
        btn.setAttribute('aria-label', 'Eliminar imagen');
      } else {
        // Marcar para eliminar
        deletedImageIds.add(imageId);
        figure.style.opacity = '0.4';
        figure.style.pointerEvents = 'none';
        figure.style.textDecoration = 'line-through';
        btn.setAttribute('aria-label', 'Restaurar imagen');
      }

      hasUnsavedChanges = true;
      updateImageCountLabel();
      updateUploadDisabled();
    });
  });

  photoInput?.addEventListener('change', () => {
    const files = Array.from(photoInput.files ?? []);
    setError('photos', validateFiles(files));
    renderPreviews(files);
    hasUnsavedChanges = true;
  });

  form?.addEventListener('input', () => {
    hasUnsavedChanges = true;
  });

  window.addEventListener('beforeunload', (e) => {
    if (hasUnsavedChanges) {
      e.preventDefault();
      e.returnValue = '';
    }
  });

  // Estado inicial
  updateUploadDisabled();

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !submitButton) return;
    ['name', 'price', 'quantity', 'categoryId', 'photos'].forEach((field) =>
      setError(field),
    );
    if (message) message.className = 'hidden';

    const values = new FormData(form);
    const productId = String(values.get('productId') ?? '');
    const name = String(values.get('name') ?? '').trim();
    const price = Number(values.get('price'));
    const quantityText = String(values.get('quantity') ?? '');
    const quantity = Number(quantityText);
    const categoryId = String(values.get('categoryId') ?? '');
    const files = Array.from(photoInput?.files ?? []);

    let valid = true;
    if (!name) {
      setError('name', 'El nombre es obligatorio.');
      valid = false;
    }
    if (!Number.isFinite(price) || price <= 0) {
      setError('price', 'Ingresa un precio mayor a cero.');
      valid = false;
    }
    if (!quantityText || !Number.isInteger(quantity) || quantity < 0) {
      setError('quantity', 'Ingresa una cantidad entera igual o mayor a cero.');
      valid = false;
    }
    if (!categoryId) {
      setError('categoryId', 'Selecciona una categoría.');
      valid = false;
    }
    const photoError = validateFiles(files);
    if (photoError) {
      setError('photos', photoError);
      valid = false;
    }
    if (!valid) return;

    submitButton.disabled = true;
    submitButton.textContent = 'Guardando…';

    try {
      // 1. Actualizar datos del producto
      const productData = new FormData();
      productData.set('name', name);
      productData.set('description', String(values.get('description') ?? ''));
      productData.set('price', String(price));
      productData.set('quantity', String(quantity));
      productData.set('categoryId', categoryId);

      const productResponse = await fetch(`/api/admin/products/${productId}`, {
        method: 'PATCH',
        body: productData,
      });

      const productResult = await productResponse.json().catch(() => ({}));
      if (!productResponse.ok) {
        if (productResult.errors)
          Object.entries(productResult.errors).forEach(([field, error]) =>
            setError(field, String(error)),
          );
        showMessage(
          productResult.message ??
            'No pudimos guardar los cambios. Revisa los campos e inténtalo nuevamente.',
          'error',
        );
        return;
      }

      // 2. Eliminar imágenes marcadas PRIMERO (antes de subir nuevas)
      if (deletedImageIds.size > 0) {
        const deleteResponse = await fetch(
          `/api/admin/products/${productId}/images`,
          {
            method: 'DELETE',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ imageIds: Array.from(deletedImageIds) }),
          },
        );

        if (!deleteResponse.ok) {
          const deleteResult = await deleteResponse.json().catch(() => ({}));
          showMessage(
            deleteResult.message ??
              'Los datos se guardaron pero no pudimos eliminar las imágenes.',
            'error',
          );
          return;
        }
      }

      // 3. Subir nuevas imágenes DESPUÉS de eliminar
      if (files.length > 0) {
        const imagesData = new FormData();
        files.forEach((file) => imagesData.append('photos', file));

        const imagesResponse = await fetch(
          `/api/admin/products/${productId}/images`,
          {
            method: 'POST',
            body: imagesData,
          },
        );

        if (!imagesResponse.ok) {
          const imagesResult = await imagesResponse.json().catch(() => ({}));
          showMessage(
            imagesResult.message ??
              'Los datos se guardaron pero no pudimos subir las nuevas imágenes.',
            'error',
          );
          return;
        }
      }

      hasUnsavedChanges = false;
      window.location.assign('/admin/products?updated=1');
    } catch {
      showMessage(
        'No se pudo conectar al servidor. Tus datos siguen aquí para que puedas reintentar.',
        'error',
      );
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = 'Guardar cambios';
    }
  });
</script>

<style>
  .field {
    width: 100%;
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.75rem;
    background: var(--color-background);
    color: var(--color-text-primary);
    padding: 0.625rem 1rem;
    font-size: 0.875rem;
    outline: none;
  }

  .field::placeholder {
    color: var(--color-text-disabled);
  }
  .field:focus {
    border-color: var(--color-primary-500);
  }
  .field-error {
    display: block;
    min-height: 1.25rem;
    margin-top: 0.375rem;
    color: var(--color-error-500);
    font-size: 0.75rem;
    font-weight: 500;
  }
</style>

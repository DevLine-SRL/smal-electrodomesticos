---
import type { Category, ProductStatusFilter } from '../../../types/products';

interface Props {
  selectedStatus: ProductStatusFilter;
  selectedCategorySlug: string;
  categories: Category[];
  searchTerm: string;
  totalProducts: number;
  view?: 'grid' | 'list';
  currentPage?: number;
}

const {
  selectedStatus,
  selectedCategorySlug,
  categories,
  searchTerm,
  totalProducts,
  view = 'grid',
  currentPage = 1,
} = Astro.props;

const OPTIONS: { value: ProductStatusFilter; label: string }[] = [
  { value: 'todos', label: 'Todos' },
  { value: 'available', label: 'Disponibles' },
  { value: 'out_of_stock', label: 'Agotados' },
  { value: 'sold', label: 'Vendidos' },
];

const buildHref = (
  status: ProductStatusFilter,
  categorySlug: string = selectedCategorySlug,
  targetView: 'grid' | 'list' = view,
) => {
  const params = new URLSearchParams();
  if (searchTerm) params.set('q', searchTerm);
  if (status !== 'todos') params.set('estado', status);
  if (categorySlug !== 'todas') params.set('categoria', categorySlug);
  if (currentPage > 1) params.set('page', String(currentPage));
  params.set('vista', targetView);
  const query = params.toString();
  return query ? `/admin/products?${query}` : '/admin/products';
};
---

<div class="flex flex-col gap-4">
  <form method="GET" action="/admin/products" class="flex flex-col gap-2 sm:flex-row sm:items-center">
    <input
      type="search"
      name="q"
      value={searchTerm}
      placeholder="Buscar por nombre…"
      class="border-border-subtle bg-background-soft text-text-primary placeholder:text-text-disabled focus:border-primary-500 min-w-0 flex-1 rounded-xl border px-4 py-2.5 text-sm transition-colors outline-none"
    />
    <select
      name="categoria"
      class="border-border-subtle bg-background-soft text-text-primary focus:border-primary-500 w-full cursor-pointer rounded-xl border px-4 py-2.5 text-sm outline-none sm:w-auto"
    >
      <option value="todas" selected={selectedCategorySlug === 'todas'}>
        Todas
      </option>
      {
        categories.map((category) => (
          <option
            value={category.slug}
            selected={selectedCategorySlug === category.slug}
          >
            {category.name}
          </option>
        ))
      }
    </select>
    {
      selectedStatus !== 'todos' && (
        <input type="hidden" name="estado" value={selectedStatus} />
      )
    }
    <input type="hidden" name="vista" value={view} />
    <button
      type="submit"
      class="bg-primary-400 text-primary-950 hover:bg-primary-300 w-full shrink-0 cursor-pointer rounded-xl px-5 py-2.5 text-sm font-bold transition-all hover:shadow-[0_0_20px_rgb(109,209,22,0.25)] sm:w-auto"
    >
      Buscar
    </button>
  </form>

  <div class="flex flex-wrap items-center gap-2">
    {
      OPTIONS.map((option) => (
        <a
          href={buildHref(option.value)}
          aria-current={option.value === selectedStatus ? 'true' : undefined}
          class:list={[
            'rounded-lg px-3.5 py-1.5 text-sm font-semibold transition-all',
            option.value === selectedStatus
              ? 'border-primary-400/40 bg-primary-400/15 text-primary-400 border'
              : 'border-border-subtle text-text-secondary hover:text-text-primary hover:border-border-strong border',
          ]}
        >
          {option.label}
        </a>
      ))
    }

    <span class="text-text-muted ml-auto text-sm">
      {totalProducts} producto{totalProducts === 1 ? '' : 's'}
    </span>

    {
      /* View toggle: navegación real vía href para que el server re-renderice
        AdminProductCard con el `view` correcto (prerender = false en la página padre) */
    }
    <div
      class="bg-background-soft border-border-subtle inline-flex rounded-lg border p-0.5"
    >
      <a
        href={buildHref(selectedStatus, selectedCategorySlug, 'grid')}
        aria-current={view === 'grid' ? 'true' : undefined}
        class:list={[
          'rounded-md p-1.5 transition-all',
          view === 'grid'
            ? 'bg-primary-400/15 text-primary-400'
            : 'text-text-muted hover:text-text-secondary',
        ]}
        title="Vista en cuadrícula"
      >
        <svg
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"
          ></path>
        </svg>
      </a>
      <a
        href={buildHref(selectedStatus, selectedCategorySlug, 'list')}
        aria-current={view === 'list' ? 'true' : undefined}
        class:list={[
          'rounded-md p-1.5 transition-all',
          view === 'list'
            ? 'bg-primary-400/15 text-primary-400'
            : 'text-text-muted hover:text-text-secondary',
        ]}
        title="Vista en lista"
      >
        <svg
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</div>

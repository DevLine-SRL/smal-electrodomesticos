---
import Logo from '../ui/Logo.astro';
import XIcon from 'virtual:icons/lucide/x?astro';

interface Props {
  active?: string;
}

const { active } = Astro.props;

const ADMIN_LINKS = [
  { label: 'Dashboard', href: '/admin' },
  { label: 'Productos', href: '/admin/products' },
];
---

<div class="flex h-full flex-col">
  <div
    class="border-border-subtle flex h-16 shrink-0 items-center justify-between border-b px-6"
  >
    <Logo href="/admin" />
    <button
      id="drawer-close"
      class="border-border-subtle text-text-secondary grid h-8 w-8 cursor-pointer place-items-center rounded-full border transition-colors hover:text-white lg:hidden"
      aria-label="Cerrar menú"
    >
      <XIcon class="h-4 w-4" />
    </button>
  </div>
  <nav
    class="text-text-secondary flex flex-1 flex-col gap-1 p-4 text-sm font-medium"
  >
    {
      ADMIN_LINKS.map((link) => (
        <a
          href={link.href}
          class:list={[
            'hover:bg-background-elevated hover:text-text-primary cursor-pointer rounded-lg px-3 py-2 transition',
            active === link.href && 'bg-background-elevated text-text-primary',
          ]}
        >
          {link.label}
        </a>
      ))
    }
    <a
      href="/"
      class="hover:bg-background-elevated hover:text-text-primary cursor-pointer rounded-lg px-3 py-2 transition"
    >
      Ver sitio
    </a>
  </nav>
</div>

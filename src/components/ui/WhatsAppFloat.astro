---
import { WHATSAPP_LINK } from '../../data';
import WhatsAppIcon from 'virtual:icons/simple-icons/whatsapp?astro';
---

<a
  href={WHATSAPP_LINK}
  target="_blank"
  rel="noopener"
  aria-label="Escríbenos por WhatsApp"
  class="whatsapp-float-ring bg-primary-400 text-primary-950 hover:bg-primary-300 shadow-primary fixed right-5 bottom-5 z-[60] grid h-14 w-14 place-items-center rounded-full transition-all duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:scale-105 active:scale-95"
>
  <WhatsAppIcon class="h-7 w-7" />
</a>

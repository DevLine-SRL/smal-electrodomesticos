---
import WalletIcon from 'virtual:icons/lucide/wallet?astro';
import ShieldCheckIcon from 'virtual:icons/lucide/shield-check?astro';
import MessageCircleIcon from 'virtual:icons/lucide/message-circle?astro';
import TruckIcon from 'virtual:icons/lucide/truck?astro';

const reasons = [
  {
    Icon: WalletIcon,
    title: 'Precio justo',
    text: 'Compra directa con el mejor precio de la zona, sin intermediarios ni sorpresas.',
  },
  {
    Icon: ShieldCheckIcon,
    title: 'Garantía y respaldo',
    text: 'Trabajamos con marcas reconocidas y te acompañamos después de la compra.',
  },
  {
    Icon: MessageCircleIcon,
    title: 'Asesoría por WhatsApp',
    text: 'Resolvemos tus dudas al momento y te ayudamos a elegir el equipo ideal.',
  },
  {
    Icon: TruckIcon,
    title: 'Entrega a domicilio',
    text: 'Coordinamos el envío y la entrega para que solo te preocupes por disfrutarlo.',
  },
];
---

<section id="nosotros" class="mx-auto w-full max-w-7xl px-5 py-24 sm:px-8">
  <div class="max-w-2xl">
    <h2
      class="font-display reveal text-4xl font-extrabold tracking-tight text-white sm:text-5xl"
    >
      Por qué comprar en SMAL
    </h2>
    <p class="reveal text-text-secondary mt-4 max-w-xl leading-relaxed">
      Somos una tienda de electrodomésticos en Entre Ríos, Cochabamba. Te
      tratamos como se trata a un vecino: con confianza y respuesta rápida.
    </p>
  </div>

  <div class="mt-12 grid gap-4 sm:grid-cols-2">
    {
      reasons.map(({ Icon, title, text }, i) => (
        <div
          class={`reveal bg-card hover:ring-primary-500/40 hover:bg-card-hover relative flex flex-col gap-5 overflow-hidden rounded-3xl p-7 ring-1 ring-white/10 transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] ${
            i % 2 === 0 ? 'sm:translate-y-4' : ''
          }`}
          style={`transition-delay: ${i * 80}ms`}
        >
          <span class="bg-primary-400 text-primary-950 shadow-primary grid h-12 w-12 place-items-center rounded-2xl">
            <Icon class="h-6 w-6" />
          </span>
          <div>
            <h3 class="font-display text-xl font-bold tracking-tight text-white">
              {title}
            </h3>
            <p class="text-text-muted mt-2 leading-relaxed">{text}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>

---
import ProductGrid from '../products/ProductGrid.tsx';
import ArrowRightIcon from 'virtual:icons/lucide/arrow-right?astro';
---

<section
  id="productos"
  class="bg-background-soft border-border-subtle border-y py-24"
>
  <div class="mx-auto w-full max-w-7xl px-5 sm:px-8">
    <div
      class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"
    >
      <div class="max-w-2xl">
        <h2
          class="font-display reveal text-4xl font-extrabold tracking-tight text-white sm:text-5xl"
        >
          Lo más vendido
        </h2>
        <p class="reveal text-text-secondary mt-4 max-w-xl leading-relaxed">
          Una muestra de nuestro catálogo. Todos los precios son de contado.
        </p>
      </div>
      <a
        href="/productos"
        class="reveal text-text-secondary group inline-flex shrink-0 items-center gap-2 font-bold transition-colors hover:text-white"
      >
        <span
          class="text-primary-400 bg-primary-400/15 grid h-8 w-8 place-items-center rounded-full"
        >
          <ArrowRightIcon class="h-4 w-4" />
        </span>
        Ver catálogo completo
      </a>
    </div>

    <div class="mt-12">
      <ProductGrid client:load />
    </div>
  </div>
</section>

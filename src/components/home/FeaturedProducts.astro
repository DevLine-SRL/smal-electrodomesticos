---
import ArrowRightIcon from 'virtual:icons/lucide/arrow-right?astro';
import { supabase } from '../../db/supabase';

const { data: rows } = await supabase
  .from('products')
  .select('id, name, price, product_images(url, position), categories(name)')
  .eq('active', true)
  .eq('status', 'available')
  .order('created_at', { ascending: false })
  .limit(6);

const products = (rows ?? []).map((row) => {
  const category = Array.isArray(row.categories)
    ? row.categories[0]
    : row.categories;
  const images = Array.isArray(row.product_images)
    ? [...row.product_images].sort((a, b) => a.position - b.position)
    : [];

  return {
    id: row.id,
    name: row.name,
    price: row.price,
    categoryName: category?.name ?? 'Sin categoría',
    imageUrl: images[0]?.url ?? null,
  };
});
---

<section
  id="productos"
  class="bg-background-soft border-border-subtle border-y py-24"
>
  <div class="mx-auto w-full max-w-7xl px-5 sm:px-8">
    <div
      class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"
    >
      <div class="max-w-2xl">
        <h2
          class="font-display reveal text-4xl font-extrabold tracking-tight text-white sm:text-5xl"
        >
          Lo más vendido
        </h2>
        <p class="reveal text-text-secondary mt-4 max-w-xl leading-relaxed">
          Una muestra de nuestro catálogo. Todos los precios son de contado.
        </p>
      </div>
      <a
        href="/products"
        class="reveal text-text-secondary group inline-flex shrink-0 items-center gap-2 font-bold transition-colors hover:text-white"
      >
        <span
          class="text-primary-400 bg-primary-400/15 grid h-8 w-8 place-items-center rounded-full"
        >
          <ArrowRightIcon class="h-4 w-4" />
        </span>
        Ver catálogo completo
      </a>
    </div>

    {
      products.length === 0 ? (
        <div class="bg-card border-border-subtle mt-12 rounded-3xl border px-6 py-10 text-center">
          <p class="text-text-secondary">
            Estamos actualizando el catálogo. Muy pronto verás nuevos productos
            aquí.
          </p>
        </div>
      ) : (
        <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {products.map((product, i) => (
            <article
              class="border-border-subtle bg-card shadow-inner-dark reveal overflow-hidden rounded-3xl border"
              style={`transition-delay: ${i * 65}ms`}
            >
              {product.imageUrl ? (
                <div
                  class="catalog-image bg-background-soft relative aspect-4/3"
                  data-image-card
                >
                  <div
                    class="catalog-skeleton absolute inset-0 grid place-items-center"
                    data-skeleton
                  >
                    <span class="catalog-spinner border-t-primary-400 h-8 w-8 rounded-full border-2 border-white/20" />
                  </div>
                  <img
                    src={product.imageUrl}
                    alt={product.name}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover opacity-0 transition-opacity duration-500"
                  />
                </div>
              ) : (
                <div class="bg-background-soft text-text-muted grid aspect-4/3 place-items-center px-4 text-center">
                  <div>
                    <p class="font-mono text-xs tracking-[0.14em] uppercase">
                      Imagen
                    </p>
                    <p class="mt-2 text-sm">Foto en actualización</p>
                  </div>
                </div>
              )}

              <div class="p-5">
                <p class="text-primary-300 text-xs font-semibold tracking-[0.14em] uppercase">
                  {product.categoryName}
                </p>
                <h3 class="text-text-primary mt-2 text-lg leading-snug font-bold">
                  {product.name}
                </h3>
                <p class="text-primary-400 mt-4 text-2xl font-extrabold">
                  Bs {product.price.toLocaleString('es-BO')}
                </p>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>

<script>
  for (const card of document.querySelectorAll('[data-image-card]')) {
    const image = card.querySelector('img');
    if (!(image instanceof HTMLImageElement)) continue;

    const markReady = () => {
      card.classList.add('is-loaded');
    };

    if (image.complete) {
      markReady();
      continue;
    }

    image.addEventListener('load', markReady, { once: true });
    image.addEventListener('error', markReady, { once: true });
  }
</script>

<style>
  .catalog-image.is-loaded img {
    opacity: 1;
  }

  .catalog-skeleton {
    background: linear-gradient(110deg, #181818 10%, #222 50%, #181818 90%);
    background-size: 200% 100%;
    animation: skeleton-shimmer 1.4s linear infinite;
    transition: opacity 0.35s ease;
  }

  .catalog-image.is-loaded .catalog-skeleton {
    opacity: 0;
    pointer-events: none;
  }

  @keyframes skeleton-shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  @keyframes spinner-rotate {
    to {
      transform: rotate(360deg);
    }
  }

  .catalog-spinner {
    animation: spinner-rotate 0.8s linear infinite;
  }
</style>

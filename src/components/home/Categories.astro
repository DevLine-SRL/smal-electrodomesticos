---
import { buildCategoryWhatsAppLink } from '../../data';
import CookingPotIcon from 'virtual:icons/lucide/cooking-pot?astro';
import RefrigeratorIcon from 'virtual:icons/lucide/refrigerator?astro';
import SnowflakeIcon from 'virtual:icons/lucide/snowflake?astro';
import TvIcon from 'virtual:icons/lucide/tv?astro';
import WashingMachineIcon from 'virtual:icons/lucide/washing-machine?astro';
import MicrowaveIcon from 'virtual:icons/lucide/microwave?astro';
import ArrowUpRightIcon from 'virtual:icons/lucide/arrow-right?astro';

const categories = [
  {
    name: 'Cocinas',
    tag: 'A gas y eléctricas',
    Icon: CookingPotIcon,
    big: true,
  },
  {
    name: 'Refrigeradoras',
    tag: 'Para tu cocina',
    Icon: RefrigeratorIcon,
  },
  {
    name: 'Congeladores',
    tag: 'Mantén todo fresco',
    Icon: SnowflakeIcon,
  },
  {
    name: 'Televisores',
    tag: 'Smart y LED',
    Icon: TvIcon,
  },
  {
    name: 'Lavadoras',
    tag: 'Ropa limpia sin esfuerzo',
    Icon: WashingMachineIcon,
  },
  {
    name: 'Pequeños electrodomésticos',
    tag: 'Licuadoras, microondas y más',
    Icon: MicrowaveIcon,
    wide: true,
  },
];
---

<section id="categorias" class="mx-auto w-full max-w-7xl px-5 py-24 sm:px-8">
  <div class="max-w-2xl">
    <h2
      class="font-display reveal text-4xl font-extrabold tracking-tight text-white sm:text-5xl"
    >
      Encuentra lo que tu hogar necesita
    </h2>
    <p class="reveal text-text-secondary mt-4 max-w-xl leading-relaxed">
      Elige una categoría y escríbenos por WhatsApp. Te confirmamos precio,
      disponibilidad y entrega al momento.
    </p>
  </div>

  <div
    class="mt-12 grid gap-4 sm:grid-cols-2 lg:auto-rows-[11rem] lg:grid-cols-3"
  >
    {
      categories.map(({ name, tag, Icon, big, wide }, i) => (
        <a
          href={buildCategoryWhatsAppLink(name)}
          target="_blank"
          rel="noopener"
          class={`reveal group bg-card hover:ring-primary-500/60 hover:bg-card-hover relative flex flex-col justify-between overflow-hidden rounded-3xl p-6 ring-1 ring-white/10 transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-1 ${
            big ? 'sm:col-span-2 lg:col-span-1 lg:row-span-2' : ''
          } ${wide ? 'sm:col-span-2 lg:col-span-3 lg:flex-row lg:items-center' : ''}`}
          style={`transition-delay: ${(i % 3) * 70}ms`}
        >
          <div
            class={`pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100 ${
              big
                ? 'bg-gradient-premium'
                : 'from-primary-600/20 bg-gradient-to-br to-transparent'
            }`}
            aria-hidden="true"
          />

          <div class="relative flex flex-col gap-4">
            <span
              class={`grid h-12 w-12 place-items-center rounded-2xl ${
                big
                  ? 'bg-secondary-500 text-secondary-950 shadow-secondary'
                  : 'bg-primary-400 text-primary-950 shadow-primary'
              }`}
            >
              <Icon class="h-6 w-6" />
            </span>
            <div>
              <h3
                class={`font-display font-bold tracking-tight text-white ${
                  big ? 'text-3xl' : 'text-xl'
                }`}
              >
                {name}
              </h3>
              <p class="text-text-muted mt-1 text-sm">{tag}</p>
            </div>
          </div>

          <span
            class={`text-text-secondary group-hover:text-primary-400 grid h-9 w-9 shrink-0 place-items-center rounded-full border border-white/10 transition-all duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 ${
              wide ? '' : 'absolute top-5 right-5'
            }`}
            aria-hidden="true"
          >
            <ArrowUpRightIcon class="h-4 w-4" />
          </span>
        </a>
      ))
    }
  </div>
</section>

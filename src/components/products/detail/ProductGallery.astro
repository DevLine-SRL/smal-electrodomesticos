---
import { Image } from 'astro:assets';

interface Props {
  name: string;
  images: { id: string; url: string }[];
}
const { name, images } = Astro.props;
---

<product-detail-gallery
  class="block min-w-0"
  aria-label={`Fotografías de ${name}`}
>
  {
    images.length ? (
      <>
        <div
          data-track
          tabindex="0"
          aria-label="Galería: desliza o usa las flechas para cambiar de fotografía"
          class="border-border-subtle bg-card focus-visible:outline-primary-400 flex snap-x snap-mandatory overflow-x-auto rounded-3xl border focus-visible:outline-2"
        >
          {images.map((photo, index) => (
            <figure
              data-slide
              class="relative m-0 w-full shrink-0 snap-center p-4 sm:p-8"
              role="group"
              aria-label={`Fotografía ${index + 1} de ${images.length}`}
            >
              <Image
                src={photo.url}
                alt={`${name}, fotografía ${index + 1}`}
                width={1000}
                height={1000}
                widths={[400, 640, 1000]}
                sizes="(min-width: 1024px) 55vw, 100vw"
                format="webp"
                quality={80}
                fit="contain"
                loading={index === 0 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : 'auto'}
                class="aspect-square h-auto w-full object-contain"
              />
            </figure>
          ))}
        </div>
        {images.length > 1 && (
          <div data-controls hidden>
            <div class="mt-4 flex items-center justify-between gap-4">
              <button
                type="button"
                data-previous
                aria-label="Fotografía anterior"
                class="border-border-subtle hover:border-primary-400 h-11 w-11 rounded-full border text-xl"
              >
                ←
              </button>
              <p
                data-counter
                aria-live="polite"
                aria-atomic="true"
                class="text-text-muted text-sm"
              >
                1 / {images.length}
              </p>
              <button
                type="button"
                data-next
                aria-label="Fotografía siguiente"
                class="border-border-subtle hover:border-primary-400 h-11 w-11 rounded-full border text-xl"
              >
                →
              </button>
            </div>
            <div
              class="mt-4 flex gap-3 overflow-x-auto pb-2"
              aria-label="Elegir fotografía"
            >
              {images.map((photo, index) => (
                <button
                  type="button"
                  data-thumbnail={index}
                  aria-label={`Ver fotografía ${index + 1}`}
                  aria-pressed={index === 0}
                  class="border-border-subtle bg-card aria-pressed:border-primary-400 focus-visible:outline-primary-400 shrink-0 overflow-hidden rounded-xl border-2 p-1 focus-visible:outline-2"
                >
                  <Image
                    src={photo.url}
                    alt=""
                    width={80}
                    height={80}
                    format="webp"
                    quality={65}
                    fit="contain"
                    loading="lazy"
                    class="h-16 w-16 object-contain sm:h-20 sm:w-20"
                  />
                </button>
              ))}
            </div>
          </div>
        )}
      </>
    ) : (
      <div class="border-border-subtle bg-card text-text-muted grid aspect-square place-items-center rounded-3xl border p-8 text-center">
        <p>Fotografías en actualización</p>
      </div>
    )
  }
</product-detail-gallery>

<script>
  class ProductDetailGallery extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      const track = this.querySelector<HTMLElement>('[data-track]');
      const slides = Array.from(
        this.querySelectorAll<HTMLElement>('[data-slide]'),
      );
      const controls = this.querySelector<HTMLElement>('[data-controls]');
      if (!track || !controls || slides.length < 2) return;
      this.dataset.ready = 'true';
      controls.hidden = false;
      let current = 0;
      const thumbnails =
        this.querySelectorAll<HTMLButtonElement>('[data-thumbnail]');
      const counter = this.querySelector('[data-counter]');
      const show = (index: number) => {
        current = (index + slides.length) % slides.length;
        track.scrollTo({
          left: current * track.clientWidth,
          behavior: 'instant',
        });
        update();
      };
      const update = () => {
        current = Math.round(track.scrollLeft / track.clientWidth);
        thumbnails.forEach((button, index) =>
          button.setAttribute('aria-pressed', String(index === current)),
        );
        if (counter) counter.textContent = `${current + 1} / ${slides.length}`;
      };
      this.querySelector('[data-previous]')?.addEventListener('click', () =>
        show(current - 1),
      );
      this.querySelector('[data-next]')?.addEventListener('click', () =>
        show(current + 1),
      );
      thumbnails.forEach((button, index) =>
        button.addEventListener('click', () => show(index)),
      );
      track.addEventListener('scroll', update, { passive: true });
      track.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        show(current + (event.key === 'ArrowRight' ? 1 : -1));
      });
    }
  }
  if (!customElements.get('product-detail-gallery'))
    customElements.define('product-detail-gallery', ProductDetailGallery);
</script>

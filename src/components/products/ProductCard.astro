---
import type { ProductListItem } from '../../types/products';

interface Props {
  product: ProductListItem;
}

const { product } = Astro.props;
---

<article
  class="border-border-subtle bg-card shadow-inner-dark overflow-hidden rounded-3xl border"
>
  {
    product.imageUrl ? (
      <div
        class="catalog-image bg-background-soft relative aspect-[4/3]"
        data-image-card
      >
        <div
          class="catalog-skeleton absolute inset-0 grid place-items-center"
          data-skeleton
        >
          <span class="catalog-spinner border-t-primary-400 h-8 w-8 rounded-full border-2 border-white/20" />
        </div>
        <img
          src={product.imageUrl}
          alt={product.name}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover opacity-0 transition-opacity duration-500"
        />
      </div>
    ) : (
      <div class="bg-background-soft text-text-muted grid aspect-[4/3] place-items-center px-4 text-center">
        <div>
          <p class="font-mono text-xs tracking-[0.14em] uppercase">Imagen</p>
          <p class="mt-2 text-sm">Foto en actualización</p>
        </div>
      </div>
    )
  }

  <div class="p-5">
    <p
      class="text-primary-300 text-xs font-semibold tracking-[0.14em] uppercase"
    >
      {product.categoryName}
    </p>
    <h3 class="text-text-primary mt-2 text-lg leading-snug font-bold">
      {product.name}
    </h3>
    <p class="text-primary-400 mt-4 text-2xl font-extrabold">
      Bs {product.price.toLocaleString('es-BO')}
    </p>
  </div>
</article>

<script>
  for (const card of document.querySelectorAll('[data-image-card]')) {
    const image = card.querySelector('img');
    if (!(image instanceof HTMLImageElement)) continue;

    const markReady = () => card.classList.add('is-loaded');

    if (image.complete) {
      markReady();
      continue;
    }

    image.addEventListener('load', markReady, { once: true });
    image.addEventListener('error', markReady, { once: true });
  }
</script>

<style>
  .catalog-image.is-loaded img {
    opacity: 1;
  }

  .catalog-skeleton {
    background: linear-gradient(110deg, #181818 10%, #222 50%, #181818 90%);
    background-size: 200% 100%;
    animation: skeleton-shimmer 1.4s linear infinite;
    transition: opacity 0.35s ease;
  }

  .catalog-image.is-loaded .catalog-skeleton {
    opacity: 0;
    pointer-events: none;
  }

  @keyframes skeleton-shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  @keyframes spinner-rotate {
    to {
      transform: rotate(360deg);
    }
  }

  .catalog-spinner {
    animation: spinner-rotate 0.8s linear infinite;
  }
</style>
